# Supabase Configuration (Required for authentication and database)
# Get these from your Supabase project at https://app.supabase.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# Service role key (Required only for leaderboard)
# Keep this secret and never expose it to the frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI Configuration (Required for AI Code Mentor)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration (Frontend origins)
# Update these with your actual frontend URLs
CODEQUEST_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: Isolated Code Runner (Judge0-compatible)
# Only set if you have a private Judge0 server configured
# RUNNER_API_URL=https://your-private-judge0.example
# RUNNER_API_KEY=your-server-side-runner-key
# RUNNER_PYTHON_LANGUAGE_ID=71
# RUNNER_JAVA_LANGUAGE_ID=62
# RUNNER_CPP_LANGUAGE_ID=54
