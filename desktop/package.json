{
  "name": "codequest-desktop",
  "version": "0.1.0",
  "description": "Desktop shell for CodeQuest",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.codequest.desktop",
    "productName": "CodeQuest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "assistant.html",
      "assistant-renderer.js",
      "local-indexer.cjs",
      "api-url.cjs",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "DangerZone8",
        "repo": "AI_Mentor",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CodeQuest-Setup.${ext}",
      "publish": [
        "github"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "CodeQuest-macOS.${ext}",
      "publish": [
        "github"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "CodeQuest-Linux.${ext}",
      "publish": [
        "github"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DangerZone8/AI_Mentor.git"
  }
}
